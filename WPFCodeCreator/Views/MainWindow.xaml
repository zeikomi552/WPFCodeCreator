<mah:MetroWindow
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:local="clr-namespace:WPFCodeCreator"
        TitleCharacterCasing="Normal"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:UserControls="clr-namespace:WPFCodeCreator.Views.UserControls" x:Class="WPFCodeCreator.Views.MainWindow"
        mc:Ignorable="d"
        Title="WPFCodeCreator" Height="800" Width="1200" Icon="/app.ico">
    <Grid>
        <TabControl>
            <TabItem Header="プロパティ">
                <ContentControl prism:RegionManager.RegionName="PropertyRegion" />
            </TabItem>
            <TabItem Header="依存プロパティ">
                <ContentControl prism:RegionManager.RegionName="DependensyPropertyRegion" />
            </TabItem>
            <TabItem Header="コンバーター">
                <ContentControl prism:RegionManager.RegionName="ConverterRegion" />
            </TabItem>
            <TabItem Header="アクション">
                <ContentControl prism:RegionManager.RegionName="ActionRegion" />
            </TabItem>
            <TabItem Header="ビヘイビア">
                <ContentControl prism:RegionManager.RegionName="BehaviorRegion" />
            </TabItem>
            
        </TabControl>
    </Grid>
</mah:MetroWindow>
